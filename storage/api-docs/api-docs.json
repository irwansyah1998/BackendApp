                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Keyboard"
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 149000
                                    },
                                    "description": {
                                        "type": "string",
